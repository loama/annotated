{
  "manifest_version": 3,
  "name": "Annotated",
  "version": "1.0.2",
  "description": "Clip the exact part that matters, add your perspective, and keep the original source attached.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "action": {
    "default_title": "Open Annotated",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://annotated-beta.vercel.app;"
  }
}
